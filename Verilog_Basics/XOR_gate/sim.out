#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x5f3f4b9ad230 .scope module, "xor_gate_tb" "xor_gate_tb" 2 11;
 .timescale 0 0;
v0x5f3f4b9be510_0 .var "a", 0 0;
v0x5f3f4b9be5e0_0 .var "b", 0 0;
v0x5f3f4b9be6b0_0 .net "y", 0 0, L_0x5f3f4b9be7b0;  1 drivers
S_0x5f3f4b9ad3c0 .scope module, "uut" "xor_gate" 2 18, 2 1 0, S_0x5f3f4b9ad230;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
L_0x5f3f4b9be7b0 .functor XOR 1, v0x5f3f4b9be510_0, v0x5f3f4b9be5e0_0, C4<0>, C4<0>;
v0x5f3f4b974490_0 .net "a", 0 0, v0x5f3f4b9be510_0;  1 drivers
v0x5f3f4b9be330_0 .net "b", 0 0, v0x5f3f4b9be5e0_0;  1 drivers
v0x5f3f4b9be3f0_0 .net "y", 0 0, L_0x5f3f4b9be7b0;  alias, 1 drivers
    .scope S_0x5f3f4b9ad230;
T_0 ;
    %vpi_call 2 21 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call 2 22 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5f3f4b9ad230 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5f3f4b9be510_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5f3f4b9be5e0_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5f3f4b9be510_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5f3f4b9be5e0_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5f3f4b9be510_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5f3f4b9be5e0_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5f3f4b9be510_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5f3f4b9be5e0_0, 0, 1;
    %delay 10, 0;
    %vpi_call 2 29 "$finish" {0 0 0};
    %end;
    .thread T_0;
